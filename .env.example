APP_NAME="연록"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd에 이 폴더를 어떤 이름으로 넣었든, 그 폴더명.test 와 정확히 똑같이 맞춰주세요.
# 예: 폴더가 C:\Users\pc\Herd\yeonbun 이면 APP_URL=http://yeonbun.test
# 여기가 실제 접속 도메인과 다르면 카카오/네이버 로그인 콜백, 토스페이먼츠 결제(successUrl) 둘 다 깨져요.
APP_URL=http://yeonbun.test

# console.anthropic.com 에서 발급받은 키를 넣으세요. (필수)
ANTHROPIC_API_KEY=
# 기본값 claude-sonnet-5. 필요하면 다른 모델 ID로 교체하세요.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# developers.kakao.com > 내 애플리케이션 > 앱 키의 REST API 키 / 카카오 로그인 > 보안(Client Secret)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 카카오 로그인 > Redirect URI 에 아래와 "정확히" 같은 값을 등록해야 함 (APP_URL 맞춰서 수정)
KAKAO_REDIRECT_URI=http://yeonbun.test/auth/kakao/callback

# developers.naver.com > Application > 내 애플리케이션 > Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 로그인 > Callback URL 에 아래와 "정확히" 같은 값을 등록해야 함 (APP_URL 맞춰서 수정)
NAVER_REDIRECT_URI=http://yeonbun.test/auth/naver/callback

# developers.tosspayments.com 회원가입(이메일만으로 가능) > 개발자센터 > API 키 메뉴에서 확인.
# test_ck_/test_sk_ 로 시작하는 테스트 키는 사업자등록 없이 바로 발급되고, 실제로 돈이 빠져나가지 않아요.
# 비워두면 코인 충전 페이지가 자동으로 "로컬 테스트용 즉시 지급" 방식으로 동작해요.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 전자상거래법상 결제(통신판매)를 받는 사업자는 홈페이지에 사업자 정보를 표시해야 해요.
# 사업자등록 전(테스트 단계)이면 전부 비워두세요 — BUSINESS_REG_NO가 비어있으면
# 화면에 아무것도 표시되지 않아요. 사업자등록증이 나오면 아래를 채우면 footer에 자동으로 노출됩니다.
# 통신판매업 신고는 별도(면제 기준: 간이과세자이거나 직전년도 거래 50회 미만인 경우 등) —
# 정확한 신고 대상 여부는 정부24 통신판매업신고 페이지나 세무사를 통해 확인하는 걸 추천해요.
BUSINESS_NAME=
BUSINESS_OWNER=
BUSINESS_REG_NO=
BUSINESS_MAIL_ORDER_NO=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# 푸터 인스타그램 아이콘이 연결될 계정 URL(예: https://www.instagram.com/yeonrok_official).
# 비워두면 아이콘이 표시되지 않아요.
BUSINESS_INSTAGRAM=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
